DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: faster slash-command updates
# DISCORD_GUILD_ID=

# Your Discord user id(s) — comma-separated. Tagged as role=owner / YOU.
# Right-click yourself in Discord → Copy User ID (Developer Mode on).
# Solonaras (website mic = same person):
DISCORD_OWNER_USER_IDS=1414944231222411378

RIKO_HTTP_URL=http://127.0.0.1:8100

# Listen in VC (Whisper via project .venv). Set 0 to disable.
LUNA_DISCORD_LISTEN=1
WHISPER_MODEL=base
# LUNA_SPEECH_END_SILENCE_MS=1400

# VC TTS loudness (1.0 = normal, 2.0 = louder for other bots to hear). Max 4.
LUNA_TTS_VOLUME=2.0

# Wake word — STT still runs on everyone; she only replies when woken.
# LUNA_WAKE_REQUIRED=1
# LUNA_WAKE_WORDS=luna,hey luna,okay luna,ok luna
# LUNA_WAKE_FOLLOWUP_MS=0

# Music (system yt-dlp + ffmpeg on PATH)
# YTDLP_BINARY=yt-dlp
# FFMPEG_BINARY=ffmpeg
# DistroKid / local library folder (voice: "Luna play distrokid …")
LUNA_DISTROKID_DIR=D:\Music for distrokid
# Optional override for radio-stations.json path
# LUNA_RADIO_STATIONS_FILE=radio-stations.json
